{
  "entities": {
    "User": {
      "title": "User",
      "description": "Padel player or admin user profile in Tbilisi",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "maxLength": 100 },
        "avatar": { "type": "string", "maxLength": 500 },
        "age": { "type": "number" },
        "location": { "type": "string", "maxLength": 100 },
        "skillLevel": { "type": "string", "enum": ["Beginner", "Intermediate", "Advanced", "Pro", "Open to All"] },
        "preferredPosition": { "type": "string", "enum": ["Left / Drive", "Right / Backhand", "Flexible"] },
        "playingStyle": { "type": "string", "maxLength": 100 },
        "bio": { "type": "string", "maxLength": 500 },
        "role": { "type": "string", "enum": ["user", "admin"] },
        "createdAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "name", "email", "skillLevel", "role"]
    },
    "Match": {
      "title": "Match",
      "description": "Padel match booking event in Tbilisi",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 150 },
        "locationName": { "type": "string", "maxLength": 150 },
        "address": { "type": "string", "maxLength": 200 },
        "district": { "type": "string", "maxLength": 100 },
        "date": { "type": "string", "maxLength": 50 },
        "dayOfWeek": { "type": "string", "maxLength": 30 },
        "startTime": { "type": "string", "maxLength": 20 },
        "durationMinutes": { "type": "number" },
        "totalSpots": { "type": "number" },
        "joinedUserIds": { "type": "array" },
        "skillLevelRequired": { "type": "string" },
        "courtCostGel": { "type": "number" },
        "pricePerPlayerGel": { "type": "number" },
        "description": { "type": "string", "maxLength": 1000 },
        "status": { "type": "string", "enum": ["Open", "Fully Booked", "Completed", "Cancelled"] },
        "createdByAdminId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "title", "locationName", "date", "startTime", "status"]
    },
    "PaymentRecord": {
      "title": "PaymentRecord",
      "description": "Match fee payment record",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "userName": { "type": "string", "maxLength": 100 },
        "matchId": { "type": "string", "maxLength": 128 },
        "matchTitle": { "type": "string", "maxLength": 150 },
        "amountGel": { "type": "number" },
        "paymentMethod": { "type": "string", "enum": ["Apple Pay", "Google Pay", "Credit Card"] },
        "status": { "type": "string", "enum": ["Completed", "Refunded"] },
        "createdAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "userId", "matchId", "amountGel", "status"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "User" },
      "description": "User profiles collection"
    },
    "/matches/{matchId}": {
      "schema": { "$ref": "Match" },
      "description": "Padel matches collection"
    },
    "/payments/{paymentId}": {
      "schema": { "$ref": "PaymentRecord" },
      "description": "Payment transactions collection"
    }
  }
}
